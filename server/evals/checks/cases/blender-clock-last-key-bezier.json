    "label": "Second hand sweeps (Linear keys)",
    "file": "clock.scene.json",
    "pattern": "\"interpolation\":\\s*\\[\\s*\"LINEAR\",\\s*\"LINEAR\"\\s*\\]"
   }
  ]
 },

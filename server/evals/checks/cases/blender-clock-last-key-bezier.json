   {
    "id": "s4c1",
    "type": "file_contains",
    "label": "Minute hand ticks (Constant keys)",
    "file": "clock.scene.json",
    "pattern": "\"interpolation\":\\s*\\[\\s*\"CONSTANT\",\\s*\"CONSTANT\",\\s*\"CONSTANT\",\\s*\"CONSTANT\",\\s*\"CONSTANT\"\\s*\\]"
   },
   {
    "id": "s4c2",

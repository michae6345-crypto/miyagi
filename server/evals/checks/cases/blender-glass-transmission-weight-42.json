{
 "id": "blender-glass-transmission-weight-42",
 "kind": "blender",
 "trap": "false_fail",
 "expected": "pass",
 "why": "Done, but odd-looking: Blender materials lesson 2 (\"One material has full transmission and IOR 1.52, and one has emission above 0\"). In Blender 4.x the Principled BSDF input is called Transmission Weight (it was Transmission up to 3.6), so the 4.2 dump reads it by its own name as transmission_weight: 1.0. The IOR typed as 1.52 is stored as float32 1.5199999809265137. The glass ball is fully transmissive at IOR 1.52 and the bulb glows at strength 5: the step is done.",
 "step": {
  "id": "s4",
  "index": 4,
  "title": "Glass and glow",
  "file": "glass.blend",
  "instructions": "Select GlassBall and give it a new material: Transmission 1, Roughness 0, IOR 1.52. Then select Bulb and give it a material with Emission Strength 5. Save (Cmd+S).",
  "checks": [
   {
    "id": "s4c1",
    "type": "file_contains",
    "label": "Full transmission",
    "file": "glass.scene.json",
    "pattern": "\"transmission\":\\s*1(?:\\.0+)?\\b"
   },
   {
    "id": "s4c2",
    "type": "file_contains",
    "label": "IOR 1.52",
    "file": "glass.scene.json",
    "pattern": "\"ior\":\\s*1\\.52\\b"
   },
   {
    "id": "s4c3",
    "type": "file_contains",
    "label": "Bulb glows",
    "file": "glass.scene.json",
    "pattern": "\"emission_strength\":\\s*(?:[1-9]\\d*(?:\\.\\d+)?|0\\.\\d*[1-9]\\d*)\\b"
   }
  ]
 },

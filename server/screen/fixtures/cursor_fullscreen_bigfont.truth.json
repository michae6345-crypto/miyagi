  "75": {
   "y": 162.0,
   "h": 21.0,
   "text": "def train(epochs: int = EPOCHS, lr: float = LEARNING_RATE, seed: int = 0):"
  },
  "76": {
   "y": 183.0,
   "h": 21.0,
   "text": "    torch.manual_seed(seed)"
  },
  "77": {
   "y": 204.0,
   "h": 21.0,
   "text": "    model = MLP()"
  },
  "78": {
   "y": 225.0,
   "h": 21.0,
   "text": "    opt = torch.optim.Adam(model.parameters(), lr=lr)"
  },
  "79": {
   "y": 246.0,
   "h": 21.0,
   "text": "    xc, tc = sample_collocation(N_COLLOCATION)"
  },
  "80": {
   "y": 267.0,
   "h": 21.0,
   "text": "    x0, t0, u0 = sample_initial(N_INITIAL)"
  },
  "81": {
   "y": 288.0,
   "h": 21.0,
   "text": "    history = []"
  },
  "82": {
   "y": 309.0,
   "h": 21.0,
   "text": "    for epoch in range(epochs + 1):"
  },
  "83": {
   "y": 330.0,
   "h": 21.0,
   "text": "        opt.zero_grad()"
  },
  "84": {
   "y": 351.0,
   "h": 21.0,
   "text": "        loss, loss_pde, loss_ic = total_loss(model, xc, tc, x0, t0, u0)"
  },
  "85": {
   "y": 372.0,
   "h": 21.0,
   "text": "        loss.backward()"
  },
  "86": {
   "y": 393.0,
   "h": 21.0,
   "text": "        opt.step()"
  },
  "87": {
   "y": 414.0,
   "h": 21.0,
   "text": "        if epoch % 100 == 0:"
  },
  "88": {
   "y": 435.0,
   "h": 21.0,
   "text": "            history.append(loss.item())"
  },
  "89": {
   "y": 456.0,
   "h": 21.0,
   "text": "            print(f\"epoch {epoch:5d} | loss {loss.item():.4e} | pde {loss_pde.item():.3e}\")"
  },
  "90": {
   "y": 477.0,
   "h": 21.0,
   "text": "    return model, history"
  },
  "91": {
   "y": 498.0,
   "h": 21.0,
   "text": ""
  },
  "92": {
   "y": 519.0,

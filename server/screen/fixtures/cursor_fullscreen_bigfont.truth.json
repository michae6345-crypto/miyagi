  },
  "93": {
   "y": 540.0,
   "h": 21.0,
   "text": "def evaluate(model, nx: int = 256, nt: int = 100):"
  },
  "94": {
   "y": 561.0,
   "h": 21.0,
   "text": "    x = torch.linspace(0, 2 * math.pi, nx)"
  },
  "95": {
   "y": 582.0,
   "h": 21.0,
   "text": "    t = torch.linspace(0, 1, nt)"
  },
  "96": {
   "y": 603.0,
   "h": 21.0,
   "text": "    xx, tt = torch.meshgrid(x, t, indexing=\"ij\")"
  },
  "97": {
   "y": 624.0,
   "h": 21.0,
   "text": "    with torch.no_grad():"
  },
  "98": {
   "y": 645.0,
   "h": 21.0,
   "text": "        u = model(xx.reshape(-1, 1), tt.reshape(-1, 1)).reshape(nx, nt)"
  },
  "99": {
   "y": 666.0,
   "h": 21.0,
   "text": "    exact = torch.sin(xx - BETA * tt)"
  },
  "100": {
   "y": 687.0,
   "h": 21.0,
   "text": "    err = torch.linalg.norm(u - exact) / torch.linalg.norm(exact)"
  },
  "101": {
   "y": 708.0,
   "h": 21.0,
   "text": "    return u, exact, err.item()"
  },
  "102": {
   "y": 729.0,
   "h": 21.0,
   "text": ""
  },
  "103": {
   "y": 750.0,
   "h": 21.0,
   "text": ""
  },
  "104": {
   "y": 771.0,
   "h": 21.0,
   "text": "def curriculum(betas=(1.0, 5.0, 10.0, 20.0, 30.0)):"
  },
  "105": {
   "y": 792.0,
   "h": 21.0,
   "text": "    model = None"
  },
  "106": {
   "y": 813.0,
   "h": 21.0,
   "text": "    for beta in betas:"
  },
  "107": {
   "y": 834.0,
   "h": 21.0,
   "text": "        print(f\"curriculum stage beta={beta}\")"
  },
  "108": {
   "y": 855.0,
   "h": 21.0,
   "text": "        model, _ = train(epochs=1000)"
  },
  "109": {
   "y": 876.0,
   "h": 21.0,
   "text": "    return model"
  },

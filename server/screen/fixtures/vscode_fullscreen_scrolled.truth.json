 "lines": {
  "44": {
   "y": 57.0,
   "h": 18.0,
   "text": "    t = torch.zeros_like(x)"
  },
  "45": {
   "y": 75.0,
   "h": 18.0,
   "text": "    return x, t, torch.sin(x)"
  },
  "46": {
   "y": 93.0,
   "h": 18.0,
   "text": ""
  },
  "47": {
   "y": 111.0,

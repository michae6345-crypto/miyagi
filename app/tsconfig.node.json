{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "paths": { "@contracts/*": ["../shared/contracts/*"] }
  },
  "include": ["src/main/**/*", "src/preload/**/*", "src/common/**/*", "mock/**/*", "../shared/contracts/**/*", "electron.vite.config.ts", "vite.web.config.ts"]
}

          "body": "The optimizer sets the step. Watch the loss fall.",
          "targets": [
            { "boxId": 1, "label": "optimizer", "text": "torch.optim.Adam", "rect": { "x": 100, "y": 563, "w": 380, "h": 18 } },
            { "boxId": 2, "label": "loss", "text": "loss 1.248e+00", "rect": { "x": 70, "y": 714, "w": 420, "h": 85 } },
            { "boxId": 3, "label": "create_graph", "text": "create_graph=True", "rect": { "x": 514, "y": 474, "w": 156, "h": 34 } }
          ]
        }
      },
      {
        "wait": 100,
        "type": "spotlight",
        "payload": {
          "rect": { "x": 100, "y": 563, "w": 380, "h": 18 },
          "caption": "Start with the optimizer",
          "app": "Code",
          "matched": "torch.optim.Adam"
        }
      },
      {
        "wait": 1200,
        "type": "spotlight",
        "payload": {
          "rect": { "x": 101, "y": 564, "w": 380, "h": 18 },
          "caption": "Start with the optimizer",
          "app": "Code",
          "matched": "torch.optim.Adam"
        }
      },
      {
        "wait": 1000,
        "type": "spotlight",
        "payload": { "clear": true }
      },
      {
        "wait": 150,
        "type": "spotlight",
        "payload": {
          "rect": { "x": 70, "y": 714, "w": 420, "h": 85 },
          "caption": "Watch the loss fall",
          "app": "Code",
          "matched": "loss 1.248e+00"
        }
      }

        "type": "spotlight",
        "payload": {
          "rect": { "x": 2400, "y": 300, "w": 220, "h": 18 },
          "caption": "Open the terminal tab",
          "app": "Code"
        }
      },
      {
        "wait": 800,
        "type": "card",
        "payload": {
          "stepId": "s5",
          "kind": "hint",

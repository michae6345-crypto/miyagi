                {
                  "index": 0,
                  "title": "A single neuron",
                  "goal": "Teach what one neuron computes using only NumPy in Jupyter. Write neuron(x, w, b) that returns the dot product of inputs and weights plus a bias, and try it on three inputs.",
                  "minutes": 15,
                  "stepCount": 5,
                  "check": "run",
                  "passes": "neuron gives 0.5 for inputs 1, 2, 3 with weights 0.5, -1, 0.5 and bias 0.5.",
                  "skillIds": [
                    "nn.neuron"
                  ],
                  "state": "done",
                  "lessonId": "lesson-neur00aa",
                  "doneAt": "2026-11-13T20:00:00-08:00"
                },
                {
                  "index": 1,
                  "title": "Activation functions",
                  "goal": "Teach sigmoid, tanh and ReLU as NumPy functions that work on whole arrays, then add a sigmoid to the neuron so its output stays between 0 and 1.",
                  "minutes": 15,
                  "stepCount": 5,
                  "check": "run",
                  "passes": "sigmoid(0) is 0.5, relu(-2) is 0 and the neuron's output lies between 0 and 1.",
                  "skillIds": [
                    "nn.activation"

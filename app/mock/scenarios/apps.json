                  "index": 4,
                  "title": "Measure the error with a loss",
                  "goal": "Teach mean squared error and binary cross-entropy in NumPy by writing both as functions and scoring the untrained network's guesses against the right answers.",
                  "minutes": 15,
                  "stepCount": 5,
                  "check": "run",
                  "passes": "mse gives 0.25 for predictions 0.5, 0.5 against targets 1, 0.",
                  "skillIds": [
                    "nn.loss"
                  ],
                  "state": "todo"
                },
                {
                  "index": 5,
                  "title": "Gradients by hand",
                  "goal": "Teach the chain rule for one sigmoid neuron with squared error. Work out the gradient for the weights and the bias on paper, code it in NumPy and check it against a numerical gradient.",
                  "minutes": 25,
                  "stepCount": 6,
                  "check": "run",
                  "passes": "The hand-coded gradient matches the numerical gradient to within 1e-6.",
                  "skillIds": [
                    "nn.gradients"
                  ],
                  "state": "todo"
                },
                {
                  "index": 6,
                  "title": "Gradient descent",
                  "goal": "Teach gradient descent in NumPy by training the single neuron to act as an AND gate, nudging the weights and bias against the gradient with a learning rate for 2000 steps.",
                  "minutes": 20,
                  "stepCount": 6,
                  "check": "run",
                  "passes": "The loss ends lower than it began and all four AND cases round to the right answer.",
                  "skillIds": [
                    "nn.descent"
                  ],
                  "state": "todo"
                },
                {
                  "index": 7,
                  "title": "Backpropagation through two layers",
                  "goal": "Teach backpropagation in NumPy for the 2-4-1 network. Write backward so it returns a gradient for each weight matrix and bias, and check one of them against a numerical gradient.",
                  "minutes": 30,
                  "stepCount": 7,
                  "check": "run",
                  "passes": "Each gradient has the shape of its parameter and one passes a numerical check.",
                  "skillIds": [
                    "nn.backprop"
                  ],
                  "state": "todo"
                },
                {
                  "index": 8,
                  "title": "Train a tiny network on XOR",
                  "goal": "Teach a full training loop in NumPy. Train the 2-4-1 network on the four XOR points with forward, loss, backward and update, starting from seeded random weights, and print the loss as it falls.",

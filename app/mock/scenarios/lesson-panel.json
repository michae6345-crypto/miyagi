    "step_lp": [
      {
        "wait": 0,
        "type": "step.started",
        "payload": {
          "stepId": "lp-2",
          "index": 1,
          "title": "Normalize the pixels",
          "instructions": "Scale both image sets to values between 0 and 1.",
          "kind": "code",
          "what": "Scale both image sets to values between 0 and 1.",
          "video": {
            "videoId": "lpmnist0001",
            "start": 95,
            "end": 180
          },
          "code": "x_train = x_train / 255.0\nx_test = x_test / 255.0",
          "where": "Type this in the new cell",
          "then": "Then run it with the arrow beside the cell."
        }
      },
      {
        "wait": 50,
        "type": "status",
        "payload": {
          "state": "watching"
        }
      }
    ],
    "step_lp_notyet": [],
    "lp_check1": [
      {
        "wait": 0,
        "type": "status",
        "payload": {
          "state": "thinking",
          "detail": "Reading `x_train` and `x_test` in your kernel"
        }
      },
      {
        "wait": 1800,
        "goto": "lp_stage_notyet"
      }
    ],
    "lp_stage_checking": [
      {
        "wait": 0,
        "type": "status",
        "payload": {
          "state": "thinking",
          "detail": "Reading `x_train` and `x_test` in your kernel"
        }
      }
    ],
    "lp_stage_notyet": [
      {
        "wait": 0,
        "type": "check.updated",
        "payload": {
          "stepId": "lp-2",
          "checkId": "train",
          "label": "x_train is scaled to 0..1",
          "status": "fail",
          "detail": "Max is still 255"
        }
      },
      {
        "wait": 0,
        "type": "check.updated",
        "payload": {
          "stepId": "lp-2",
          "checkId": "test",
          "label": "x_test is scaled to 0..1",
          "status": "pass"
        }
      },
      {
        "wait": 50,
        "type": "card",
        "payload": {
          "stepId": "lp-2",
          "kind": "step",
          "source": "judge",
          "verdict": "not_done",
          "checkIds": [
            "train"
          ],
          "title": "Not yet",
          "body": "`x_train` still has values up to 255.\nOnly `x_test` was divided.",
          "actions": [
            "hint",
            "show_me"
          ],
          "missingLines": [
            {
              "text": "x_train = x_train / 255.0",
              "state": "missing"
            },
            {
              "text": "x_test = x_test / 255.0",
              "state": "ok"
            }
          ],
          "fixCaption": "Add the first line, then run the cell"
        }
      },
      {
        "wait": 50,
        "type": "status",
        "payload": {
          "state": "offtrack"
        }
      },
      {
        "wait": 0,
        "goto": "step_lp_notyet"
      }
    ],
    "lp_hint": [
      {
        "wait": 0,
        "type": "status",
        "payload": {
          "state": "thinking",
          "detail": "Writing a hint"
        }
      },
      {
        "wait": 900,
        "type": "card",
        "payload": {
          "stepId": "lp-2",
          "kind": "hint",
          "title": "Hint",
          "body": "Divide each array by the largest pixel value, `255.0`.\nDo it for `x_train` and `x_test`.",
          "hintStep": {
            "n": 1,
            "of": 2
          }
        }
      },
      {
        "wait": 50,
        "type": "status",
        "payload": {
          "state": "watching"
        }
      }
    ],
    "lp_explain": [
      {
        "wait": 0,
        "type": "status",
        "payload": {
          "state": "thinking",
          "detail": "Writing an explanation"
        }
      },
      {
        "wait": 900,
        "type": "card",
        "payload": {
          "stepId": "lp-2",
          "kind": "explain",
          "title": "Why divide by 255",
          "body": "Pixels run from 0 to 255. Small inputs keep the training steady."
        }
      },
      {
        "wait": 50,
        "type": "status",
        "payload": {
          "state": "watching"
        }
      }
    ],
    "lp_check2": [
      {
        "wait": 0,
        "type": "status",
        "payload": {
          "state": "thinking",
          "detail": "Reading `x_train` and `x_test` in your kernel"

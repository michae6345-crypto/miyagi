                  "what": "Evaluate the model on the test set."
                }
              ]
            }
          },
          "steps": [
            {
              "id": "lp-1",
              "index": 0,
              "title": "Load the data",
              "kind": "code",
              "what": "Load MNIST and look at its shape.",
              "video": {
                "videoId": "lpmnist0001",
                "start": 0,
                "end": 95
              }
            },
            {
              "id": "lp-2",
              "index": 1,
              "title": "Normalize the pixels",
              "kind": "code",
              "what": "Scale both image sets to values between 0 and 1.",
              "video": {
                "videoId": "lpmnist0001",
                "start": 95,
                "end": 180
              }
            },
            {
              "id": "lp-3",
              "index": 2,
              "title": "Build the model",
              "kind": "code",

      },
      {
        "wait": 1400,
        "goto": "lp_pass"
      }
    ],
    "lp_pass": [
      {
        "wait": 0,
        "type": "check.updated",
        "payload": {
          "stepId": "lp-2",
          "checkId": "train",
          "label": "x_train is scaled to 0..1",

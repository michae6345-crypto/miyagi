              3000,
              4000,
              5000
            ],
            "norms": [
              [
                0.9,
                0.12,
                0.02,
                0.006,
                0.003,
                0.002
              ],
              [
                1,
                0.2,
                0.05,
                0.012,
                0.006,
                0.004
              ],
              [
                1.1,
                0.35,
                0.1,
                0.03,
                0.015,
                0.01
              ],
              [
                1.2,
                0.6,
                0.3,
                0.12,
                0.08,
                0.06
              ],
              [
                1.3,
                0.9,
                0.7,
                0.5,
                0.45,
                0.4
              ]
            ]
          },
          "caption": "At β = 30 the early layers stop learning. The gradients vanish before the wave forms."
        }
      }
    ],
    "showme_step6": [
      {
        "wait": 100,
        "type": "video.seek",
        "payload": {
          "t": 870,
          "play": true
        }
      }
    ],
    "explain_step6": [
      {
        "wait": 250,
        "type": "card",
        "payload": {
          "stepId": "s6",
          "kind": "explain",
          "title": "Why β = 30 stalls",
          "body": "A steep wave makes the loss landscape rugged. Gradients in early layers vanish, so the net settles on a flat solution.",
          "videoJump": {
            "t": 870,
            "label": "14:30 · why it fails"
          }
        }
      }
    ],
    "hint_step6": [
      {
        "wait": 250,
        "type": "card",
        "payload": {
          "stepId": "s6",
          "kind": "hint",
          "title": "Hint",
          "body": "Train at β = 1 first, then reuse the weights at 5, 10, 20, 30."
        }
      }
    ]
  }
}

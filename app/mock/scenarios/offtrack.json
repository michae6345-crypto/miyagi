{
  "name": "offtrack",
  "on": {
    "connect": "resume",
    "action:apply_fix": "fix",
    "action:diagram@step6": "diagram_gradients",
    "action:show_me@step6": "showme_step6",
    "action:explain@step6": "explain_step6",
    "action:hint@step6": "hint_step6"
  },
  "segments": {
    "resume": [
      {
        "wait": 600,
        "type": "lesson.ready",
        "payload": {
          "lesson": {
            "id": "pinn-convection",
            "title": "PINNs · Convection",
            "sources": [
              {
                "id": "r1",
                "kind": "video",
                "title": "PINNs in PyTorch — Convection Equation",
                "url": "https://www.youtube.com/watch?v=PINN_TUTORIAL_TBD",
                "meta": "Video · SciML Lab · 18:40"
              },
              {
                "id": "r2",
                "kind": "notebook",
                "title": "pinn_convection.ipynb",
                "url": "https://github.com/",
                "meta": "Notebook · GitHub · runs locally"
              },
              {
                "id": "r3",
                "kind": "paper",
                "title": "Characterizing possible failure modes in PINNs",
                "url": "https://arxiv.org/abs/2109.01050",
                "meta": "Paper · Krishnapriyan et al. · NeurIPS 2021"
              }
            ]
          },
          "steps": [
            {
              "id": "s1",
              "index": 0,
              "title": "Set up the environment",
              "video": {
                "videoId": "PINN_TUTORIAL_TBD",
                "start": 0,
                "end": 70
              }
            },
            {
              "id": "s2",
              "index": 1,
              "title": "Sample collocation points",
              "video": {
                "videoId": "PINN_TUTORIAL_TBD",
                "start": 70,
                "end": 125
              }
            },
            {
              "id": "s3",
              "index": 2,
              "title": "Build the MLP",
              "video": {
                "videoId": "PINN_TUTORIAL_TBD",
                "start": 125,
                "end": 372
              }
            },
            {
              "id": "s4",
              "index": 3,
              "title": "Define the residual",
              "video": {
                "videoId": "PINN_TUTORIAL_TBD",
                "start": 372,
                "end": 588
              }
            },
            {
              "id": "s5",
              "index": 4,
              "title": "Write the training loop",
              "video": {
                "videoId": "PINN_TUTORIAL_TBD",
                "start": 588,
                "end": 760
              }
            },
            {
              "id": "s6",
              "index": 5,
              "title": "Train at β = 30",
              "video": {
                "videoId": "PINN_TUTORIAL_TBD",
                "start": 760,
                "end": 870
              }
            },
            {
              "id": "s7",
              "index": 6,
              "title": "Fix it with a β curriculum",
              "video": {
                "videoId": "PINN_TUTORIAL_TBD",
                "start": 870,
                "end": 1120
              }
            }
          ]
        }
      },
      {
        "wait": 0,
        "goto": "step6"
      }
    ],
    "after_step5": [
      {
        "wait": 0,
        "goto": "step6"
      }
    ],
    "step6": [
      {
        "wait": 300,
        "type": "step.started",
        "payload": {
          "stepId": "s6",
          "title": "Train at β = 30",
          "instructions": "Run training and watch the loss",
          "video": {
            "videoId": "PINN_TUTORIAL_TBD",
            "start": 760,
            "end": 870
          },
          "index": 5
        }
      },
      {
        "wait": 0,
        "type": "video.seek",
        "payload": {
          "t": 760,
          "play": true
        }
      },
      {
        "wait": 0,
        "type": "check.updated",
        "payload": {
          "stepId": "s6",
          "checkId": "c1",
          "label": "Residual includes β·u_x",
          "status": "pending"
        }
      },
      {
        "wait": 0,
        "type": "check.updated",
        "payload": {
          "stepId": "s6",
          "checkId": "c2",
          "label": "Training runs without errors",
          "status": "pending"
        }
      },
      {
        "wait": 0,
        "type": "check.updated",
        "payload": {
          "stepId": "s6",
          "checkId": "c3",
          "label": "Loss < 1e-2",
          "status": "pending"
        }
      },
      {
        "wait": 0,
        "type": "video.pause",
        "payload": {}
      },
      {
        "wait": 500,
        "type": "spotlight",
        "payload": {
          "file": "pinn_convection.py",
          "startLine": 24,
          "endLine": 28,
          "caption": "Run the training loop",
          "code": "python pinn_convection.py"
        }
      },
      {
        "wait": 1200,
        "type": "check.updated",
        "payload": {
          "stepId": "s6",
          "checkId": "c1",
          "label": "Residual includes β·u_x",
          "status": "pass"
        }
      },
      {
        "wait": 1400,
        "type": "check.updated",
        "payload": {
          "stepId": "s6",
          "checkId": "c2",
          "label": "Training runs without errors",
          "status": "pass"
        }
      },
      {
        "wait": 3800,
        "type": "check.updated",
        "payload": {
          "stepId": "s6",
          "checkId": "c3",
          "label": "Loss < 1e-2",
          "status": "fail",
          "detail": "yours 2.50e-1"
        }
      },
      {
        "wait": 150,
        "type": "video.pause",
        "payload": {}
      },
      {
        "wait": 0,
        "type": "offtrack",
        "payload": {
          "stepId": "s6",
          "severity": "fail",
          "reason": "loss flat for 5,200 epochs",
          "title": "Your loss is stuck at 0.25",
          "body": "Not your bug. Plain PINNs can't fit β = 30. Ramp β up instead.",
          "diff": {
            "line": 4,
            "expected": "BETA_SCHEDULE = [1, 5, 10, 20, 30]",
            "yours": "BETA = 30.0"
          },
          "actions": [
            "show_me",
            "explain",
            "apply_fix"
          ],
          "curve": {
            "label": "loss",
            "yours": [
              0,
              -0.42,
              -0.55,
              -0.59,
              -0.6,
              -0.6,
              -0.6,
              -0.6,
              -0.6,
              -0.6,
              -0.6,
              -0.6
            ],
            "tutorial": [
              0,
              -0.9,
              -1.6,
              -2.2,
              -2.7,
              -3.1,
              -3.4,
              -3.6,
              -3.8,
              -3.9,
              -4,
              -4.05
            ]
          },
          "citation": {
            "label": "Krishnapriyan et al. · NeurIPS 2021",
            "url": "https://arxiv.org/abs/2109.01050"
          }
        }
      },
      {
        "wait": 400,
        "type": "spotlight",
        "payload": {
          "file": "pinn_convection.py",
          "startLine": 4,
          "endLine": 4,
          "caption": "β = 30 is too steep to start from",
          "code": "BETA_SCHEDULE = [1, 5, 10, 20, 30]"
        }
      }
    ],
    "fix": [
      {
        "wait": 250,
        "type": "spotlight",
        "payload": {
          "file": "pinn_convection.py",
          "startLine": 4,
          "endLine": 4,
          "caption": "Curriculum applied",
          "code": "BETA_SCHEDULE = [1, 5, 10, 20, 30]"
        }
      },
      {
        "wait": 0,
        "type": "check.updated",
        "payload": {
          "stepId": "s6",
          "checkId": "c3",
          "label": "Loss < 1e-2",
          "status": "pending",
          "detail": "retraining · β 1 → 30"
        }
      },
      {
        "wait": 3600,
        "type": "check.updated",
        "payload": {
          "stepId": "s6",
          "checkId": "c3",
          "label": "Loss < 1e-2",
          "status": "pass",
          "detail": "yours 6.08e-4"
        }
      },
      {
        "wait": 450,
        "type": "step.passed",
        "payload": {
          "stepId": "s6",
          "summary": "Relative L2 error 1.8e-2. The curriculum worked."
        }
      },
      {
        "wait": 400,
        "type": "video.play",
        "payload": {}
      },
      {
        "wait": 4500,
        "goto": "step7"
      }
    ],
    "step7": [
      {
        "wait": 0,
        "type": "step.started",
        "payload": {
          "stepId": "s7",
          "title": "Compare to the exact solution",
          "instructions": "Plot predicted vs exact u(x, t)",
          "video": {
            "videoId": "PINN_TUTORIAL_TBD",
            "start": 870,
            "end": 1120
          },
          "index": 6
        }
      },
      {
        "wait": 0,
        "type": "check.updated",
        "payload": {
          "stepId": "s7",
          "checkId": "c1",
          "label": "Saves u_pred heatmap",
          "status": "pending"
        }
      },
      {
        "wait": 0,
        "type": "check.updated",
        "payload": {
          "stepId": "s7",
          "checkId": "c2",
          "label": "Relative L2 error < 5e-2",
          "status": "pending"
        }
      }
    ],
    "diagram_gradients": [
      {
        "wait": 250,
        "type": "diagram",
        "payload": {
          "kind": "gradients",
          "data": {
            "layers": [

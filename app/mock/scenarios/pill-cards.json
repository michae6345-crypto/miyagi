{
  "name": "pill-cards",
  "on": {
    "connect": "step_pc_setup",
    "action:install@step_pc_setup": "pc_install",
    "action:check_step@step_pc2": "pc_check_notyet",
    "action:hint@step_pc2b": "pc_hint",
    "action:check_step@step_pc2b": "pc_check_pass"
  },
  "segments": {
    "step_pc_setup": [
      { "wait": 150, "type": "status", "payload": { "state": "idle" } },
      { "wait": 300, "type": "card", "payload": { "kind": "setup", "title": "Before the lesson", "body": "VS Code needs the miyagi helper.", "actions": ["install", "skip_setup"], "setup": { "editorNeeded": true, "editorLabel": "Visual Studio Code", "items": [ { "tool": "vscode", "label": "Visual Studio Code", "kind": "editor", "why": "Where you write the code", "needed": true, "installed": true, "ok": true, "version": "1.96.2", "install": { "method": "download", "url": "https://code.visualstudio.com/download" } }, { "tool": "miyagi-helper", "label": "miyagi helper extension", "kind": "app", "why": "Lets miyagi run and check your code", "needed": true, "installed": false, "ok": false, "install": { "method": "none" } } ] } } }
    ],
    "pc_install": [
      { "wait": 200, "type": "setup.progress", "payload": { "tool": "miyagi-helper", "line": "Installing the extension" } },
      { "wait": 1400, "type": "setup.progress", "payload": { "tool": "miyagi-helper", "done": true, "ok": true, "version": "0.4.0" } },
      { "wait": 300, "type": "card", "payload": { "kind": "setup", "title": "Ready to go", "body": "Everything is installed.", "dismissAfterMs": 1200, "setup": { "editorNeeded": true, "editorLabel": "Visual Studio Code", "items": [ { "tool": "vscode", "label": "Visual Studio Code", "kind": "editor", "why": "Where you write the code", "needed": true, "installed": true, "ok": true, "version": "1.96.2", "install": { "method": "download", "url": "https://code.visualstudio.com/download" } }, { "tool": "miyagi-helper", "label": "miyagi helper extension", "kind": "app", "why": "Lets miyagi run and check your code", "needed": true, "installed": true, "ok": true, "version": "0.4.0", "install": { "method": "none" } } ] } } },
      { "wait": 1400, "type": "lesson.ready", "payload": { "lesson": { "id": "pc-mnist", "title": "Code your first neural network with TensorFlow", "sources": [], "mode": "lesson", "builtBy": "curated", "outline": { "count": 6, "steps": [ { "index": 0, "title": "Load the data" }, { "index": 1, "title": "Normalize the pixels" }, { "index": 2, "title": "Build the model" }, { "index": 3, "title": "Compile it" }, { "index": 4, "title": "Train it" }, { "index": 5, "title": "Check the accuracy" } ] } }, "steps": [ { "id": "pc-1", "index": 0, "title": "Load the data", "kind": "code" }, { "id": "pc-2", "index": 1, "title": "Normalize the pixels", "kind": "code" }, { "id": "pc-3", "index": 2, "title": "Build the model", "kind": "code" } ] } },
      { "wait": 200, "type": "step.passed", "payload": { "stepId": "pc-1", "nextStepId": "pc-2", "already": true } },
      { "wait": 100, "goto": "step_pc2" }
    ],
    "step_pc2": [
      { "wait": 0, "type": "step.started", "payload": { "stepId": "pc-2", "index": 1, "title": "Normalize the pixels", "instructions": "Scale both image sets to values between 0 and 1.", "kind": "code", "where": "Type this in the new cell", "code": "x_train = x_train / 255.0\nx_test = x_test / 255.0", "then": "Then run it with the arrow beside the cell.", "estMinutes": 3 } },
      { "wait": 100, "type": "check.updated", "payload": { "stepId": "pc-2", "checkId": "pc2-a", "label": "x_train is scaled", "status": "pending" } },
      { "wait": 50, "type": "check.updated", "payload": { "stepId": "pc-2", "checkId": "pc2-b", "label": "x_test is scaled", "status": "pending" } },
      { "wait": 50, "type": "status", "payload": { "state": "watching", "detail": "Watching your notebook" } }
    ],
    "pc_check_notyet": [
      { "wait": 0, "type": "status", "payload": { "state": "thinking", "detail": "Checking your cell" } },
      { "wait": 1600, "type": "check.updated", "payload": { "stepId": "pc-2", "checkId": "pc2-a", "label": "x_train is scaled", "status": "fail", "detail": "max 255" } },
      { "wait": 50, "type": "check.updated", "payload": { "stepId": "pc-2", "checkId": "pc2-b", "label": "x_test is scaled", "status": "pass" } },
      { "wait": 50, "type": "offtrack", "payload": { "stepId": "pc-2", "severity": "fail", "level": 2, "actions": ["explain", "show_me", "hint"], "title": "x_train still has values up to 255.", "body": "Only x_test was divided.", "guidingQuestion": "Which array did you leave out?" } },
      { "wait": 50, "type": "status", "payload": { "state": "offtrack" } },
      { "wait": 0, "goto": "step_pc2b" }
    ],
    "step_pc2b": [
      { "wait": 0, "type": "status", "payload": { "state": "offtrack", "detail": "Watching your notebook" } }
    ],
    "pc_hint": [
      { "wait": 0, "type": "status", "payload": { "state": "thinking" } },
      { "wait": 900, "type": "card", "payload": { "stepId": "pc-2", "kind": "hint", "title": "Hint", "body": "Divide each array by the largest pixel value, `255.0`. Do it for `x_train` and `x_test`.", "hintStep": { "n": 1, "of": 2 } } },
      { "wait": 50, "type": "status", "payload": { "state": "offtrack" } }
    ],
    "pc_check_pass": [
      { "wait": 0, "type": "status", "payload": { "state": "thinking", "detail": "Checking your cell" } },
      { "wait": 1400, "type": "check.updated", "payload": { "stepId": "pc-2", "checkId": "pc2-a", "label": "x_train is scaled", "status": "pass" } },
      { "wait": 100, "type": "step.passed", "payload": { "stepId": "pc-2", "nextStepId": "pc-3", "summary": "Both image sets now run from 0 to 1." } },
      { "wait": 50, "type": "status", "payload": { "state": "passed" } },
      { "wait": 3500, "goto": "step_pc3" }
    ],
    "step_pc3": [
      { "wait": 0, "type": "step.started", "payload": { "stepId": "pc-3", "index": 2, "title": "Build the model", "instructions": "Stack a Flatten layer and two Dense layers.", "kind": "code", "estMinutes": 4 } },
      { "wait": 50, "type": "status", "payload": { "state": "watching", "detail": "Watching your notebook" } },
      { "wait": 1500, "type": "card", "payload": { "stepId": "pc-3", "kind": "step", "title": "Not yet", "body": "No kernel is running, so I cannot check this cell.", "waiting": "Watching for a kernel to start" } },
      { "wait": 6000, "type": "card", "payload": { "stepId": "pc-3", "kind": "step", "title": "Not yet", "body": "No kernel is running, so I cannot check this cell.", "waiting": "Watching for a kernel to start", "dismissAfterMs": 1 } }
    ]
  }
}

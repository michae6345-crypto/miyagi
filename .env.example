# Copy to .env at the repo root and fill in your own keys. Never commit .env.
# This file lists names only. Keys entered in the app's Settings (Cmd+,) win over .env.

# Required. Claude writes the lessons, coaches, judges steps and reads the screen.
ANTHROPIC_API_KEY=
# Read only if you use it instead of ANTHROPIC_API_KEY; leave it commented out otherwise.
# ANTHROPIC_AUTH_TOKEN=

# Optional. Gemini watches the videos; without it, video lessons are built by Claude from the transcript.
GEMINI_API_KEY=
# Read only when GEMINI_API_KEY is empty.
# GOOGLE_API_KEY=

# Optional. Bright Data: Google video results (SERP API), YouTube comment warnings, transcripts and docs (Web Unlocker).
# The zones are the zone names in your Bright Data account.
BRIGHTDATA_API_KEY=
BRIGHTDATA_SERP_ZONE=
BRIGHTDATA_UNLOCKER_ZONE=
# The YouTube comments dataset id; the engine has a built-in default.
# BRIGHTDATA_YT_COMMENTS_DATASET=

# Optional. Tiger Data stores check results and training metrics. Create the tables once with `.venv/bin/tut db init`.
TIGER_DATABASE_URL=postgres://...

# Optional. ElevenLabs voice for the engine's spoken lines.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional. Only for GitHub repo search (FINDER_KINDS=all or a list that includes "repo").
# GITHUB_TOKEN=

# Settings
ENGINE_URL=ws://localhost:8787
DEMO=0

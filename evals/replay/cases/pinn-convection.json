 "outline": [
  {
   "step": "s1",
   "about": "a PINN class: linear layers with Tanh",
   "match": "PINN|network",
   "expect_checks": [
    {
     "type": "file_contains",
     "file": "pinn_convection.py",
     "pattern": "self\\.net = nn\\.Sequential\\(\\*layers\\)"
    }
   ],
   "actions": [
    {
     "do": "write",
     "file": "pinn_convection.py",
     "text": "\"\"\"PINN for the 1D linear convection equation u_t + beta * u_x = 0, x in [0, 2 pi], t in [0, 1], u(x, 0) = sin(x).\"\"\"\nimport argparse\nimport math\n\nimport torch\nimport torch.nn as nn\n\n\ndef log_metric(step, name, value):\n    print(f'::metric:: {{\"step\": {step}, \"name\": \"{name}\", \"value\": {value}}}', flush=True)\n\n\nclass PINN(nn.Module):\n    def __init__(self, hidden=50, depth=4):\n        super().__init__()\n        layers = [nn.Linear(2, hidden), nn.Tanh()]\n        for _ in range(depth - 1):\n            layers += [nn.Linear(hidden, hidden), nn.Tanh()]\n        layers.append(nn.Linear(hidden, 1))\n        self.net = nn.Sequential(*layers)\n\n    def forward(self, x, t):\n        return self.net(torch.cat([x, t], dim=1))\n"
    }
   ]
  },
  {
   "step": "s2",
   "about": "pde_residual with autograd du/dt and du/dx",
   "match": "residual|physics loss",
   "expect_checks": [
    {
     "type": "file_contains",
     "file": "pinn_convection.py",
     "pattern": "return du_dt \\+ beta \\* du_dx"
    }
   ],
   "actions": [
    {
     "do": "append",
     "file": "pinn_convection.py",
     "text": "def pde_residual(model, x, t, beta):\n    u = model(x, t)\n    du_dt = torch.autograd.grad(u, t, torch.ones_like(u), create_graph=True)[0]\n    du_dx = torch.autograd.grad(u, x, torch.ones_like(u), create_graph=True)[0]\n    return du_dt + beta * du_dx\n"
    }
   ]
  },
  {
   "step": "s3",
   "about": "sample_points with requires_grad, and the training loop",
   "match": "sample|training loop",
   "expect_checks": [
    {
     "type": "file_contains",
     "file": "pinn_convection.py",
     "pattern": "\\.requires_grad_\\(True\\)"
    },
    {
     "type": "command_exit_ok",
     "command": "python3 pinn_convection.py --epochs 10"
    }
   ],
   "actions": [
    {
     "do": "append",
     "file": "pinn_convection.py",
     "text": "def sample_points(n):\n    x = (torch.rand(n, 1) * 2 * math.pi).requires_grad_(True)\n    t = torch.rand(n, 1).requires_grad_(True)\n    return x, t\n\n\ndef main():\n    p = argparse.ArgumentParser()\n    p.add_argument(\"--beta\", type=float, default=1.0)\n    p.add_argument(\"--epochs\", type=int, default=4000)\n    args = p.parse_args()\n    torch.manual_seed(0)\n    model = PINN()\n    opt = torch.optim.Adam(model.parameters(), lr=1e-3)\n    x0 = torch.rand(256, 1) * 2 * math.pi\n    t0 = torch.zeros_like(x0)\n    u0 = torch.sin(x0)\n    for epoch in range(args.epochs):\n        x, t = sample_points(1000)\n        loss = pde_residual(model, x, t, args.beta).pow(2).mean() + (model(x0, t0) - u0).pow(2).mean()\n        opt.zero_grad()\n        loss.backward()\n        opt.step()\n        if epoch % 100 == 0:\n            print(f\"epoch {epoch} | beta {args.beta} | loss {loss.item():.4e}\", flush=True)\n            log_metric(epoch, \"loss\", loss.item())\n\n\nif __name__ == \"__main__\":\n    main()\n"
    },
    {
     "do": "run",
     "cmd": "python3 pinn_convection.py --epochs 10",
     "output": [
      "epoch 0 | beta 1.0 | loss 9.0200e-01",
      "::metric:: {\"step\": 0, \"name\": \"loss\", \"value\": 0.902}"
     ]
    }
   ]
  },

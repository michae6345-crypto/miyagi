{
 "id": "docker-compose-basics",
 "topic": "docker",
 "stack": "Docker Desktop + Compose v2 (VS Code, terminal, browser)",
 "tutorial": {"kind": "text", "goal": "containerize a tiny web app with a Dockerfile, run it on a port, then add Redis with docker compose",
              "video_query": "Docker tutorial for beginners Dockerfile docker compose"},
 "lesson": null,
 "learner": {
  "folder": "compose-lab",
  "notes": "docker / BuildKit / compose output in their verbatim formats; no container is built or run."
 },
 "outline": [
  {
   "about": "write a Dockerfile and docker build it", "match": "dockerfile|build",
   "expect_checks": [
    {"type": "file_contains", "file": "Dockerfile", "pattern": "^FROM python:3\\.12-slim$"},
    {"type": "screen_contains", "app": "Terminal", "pattern": "naming to docker\\.io/library/hello-app:latest"}
   ],
   "actions": [
    {"do": "write", "file": "index.html", "text": "<h1>Hello from Docker</h1>\n"},
    {"do": "write", "file": "Dockerfile", "text": "FROM python:3.12-slim\nWORKDIR /app\nCOPY index.html .\nEXPOSE 8000\nCMD [\"python\", \"-m\", \"http.server\", \"8000\"]\n"},
    {"do": "mistake", "note": "forgets the build context (the final dot)", "caught_by_spec_rows": ["x1"], "actions": [
     {"do": "run", "cmd": "docker build -t hello-app", "exit": 1, "output": ["ERROR: \"docker buildx build\" requires exactly 1 argument.",
      "See 'docker buildx build --help'.", "", "Usage:  docker buildx build [OPTIONS] PATH | URL | -", "", "Start a build"]}
    ]},
    {"do": "run", "cmd": "docker build -t hello-app .", "output": ["[+] Building 6.2s (8/8) FINISHED                                     docker:desktop-linux",
     " => [internal] load build definition from Dockerfile                                     0.0s", " => [internal] load metadata for docker.io/library/python:3.12-slim       1.1s",
     " => [1/3] FROM docker.io/library/python:3.12-slim@sha256:2b0079146a74e23bf4ae8f6a28e1b484c6292f6fb904cbb51825b4a19812fcd8   4.3s",
     " => [2/3] WORKDIR /app                                                                    0.2s", " => [3/3] COPY index.html .                                                               0.0s",
     " => exporting to image                                                                    0.1s", " => => exporting layers                                                                 0.1s",
     " => => writing image sha256:5f1c0f6b1d9a8e7c6b5a4d3c2b1a0f9e8d7c6b5a4f3e2d1c0b9a8f7e6d5c4b3a                    0.0s",
     " => => naming to docker.io/library/hello-app:latest                                       0.0s"]}
   ]
  },
  {
   "about": "run it with -p 8000:8000 and open it in the browser", "match": "run|port",
   "expect_checks": [
    {"type": "screen_contains", "app": "Terminal", "pattern": "Serving HTTP on 0\\.0\\.0\\.0 port 8000"},
    {"type": "screen_contains", "app": "Google Chrome", "pattern": "Hello from Docker"}
   ],
   "actions": [
    {"do": "mistake", "note": "runs without -p, so localhost:8000 refuses to connect", "caught_by_spec_rows": ["x1"], "actions": [
     {"do": "run", "cmd": "docker run --rm hello-app", "running": true, "output": ["Serving HTTP on 0.0.0.0 port 8000 (http://0.0.0.0:8000/) ..."]},
     {"do": "browser", "lines": ["localhost:8000", "This site can’t be reached", "localhost refused to connect.", "ERR_CONNECTION_REFUSED"]}
    ]},
    {"do": "run", "cmd": "docker run --rm -p 8000:8000 hello-app", "running": true, "output": ["Serving HTTP on 0.0.0.0 port 8000 (http://0.0.0.0:8000/) ...",
     "192.168.65.1 - - [21/Nov/2026 18:04:12] \"GET / HTTP/1.1\" 200 -"]},
    {"do": "browser", "lines": ["localhost:8000", "Hello from Docker"]}
   ]
  },
  {
   "about": "compose.yaml with the web app and redis; docker compose up", "match": "compose",
   "expect_checks": [
    {"type": "file_contains", "file": "compose.yaml", "pattern": "image: redis:7-alpine"},
    {"type": "screen_contains", "app": "Terminal", "pattern": "redis-1\\s+\\|.*Ready to accept connections"}
   ],
   "actions": [
    {"do": "mistake", "note": "indents compose.yaml with a tab", "caught_by_spec_rows": ["x1"], "actions": [
     {"do": "write", "file": "compose.yaml", "text": "services:\n\tweb:\n    build: .\n    ports:\n      - \"8000:8000\"\n  redis:\n    image: redis:7-alpine\n"},
     {"do": "run", "cmd": "docker compose up", "exit": 15, "output": ["yaml: line 2: found character that cannot start any token"]}
    ]},
    {"do": "write", "file": "compose.yaml", "text": "services:\n  web:\n    build: .\n    ports:\n      - \"8000:8000\"\n  redis:\n    image: redis:7-alpine\n"},
    {"do": "run", "cmd": "docker compose up", "running": true, "output": ["[+] Running 3/3", " ✔ Network compose-lab_default    Created   0.0s",
     " ✔ Container compose-lab-redis-1  Created   0.1s", " ✔ Container compose-lab-web-1    Created   0.1s", "Attaching to redis-1, web-1",
     "redis-1  | 1:C 21 Nov 2026 18:06:01.112 * oO0OoO0OoO0Oo Redis is starting oO0OoO0OoO0Oo",
     "redis-1  | 1:M 21 Nov 2026 18:06:01.115 * Ready to accept connections tcp",
     "web-1    | Serving HTTP on 0.0.0.0 port 8000 (http://0.0.0.0:8000/) ..."]}
   ]
  },
  {
   "about": "docker compose down", "match": "down|stop",
   "expect_checks": [
    {"type": "screen_contains", "app": "Terminal", "pattern": "Network compose-lab_default\\s+Removed"}
   ],
   "actions": [
    {"do": "run", "cmd": "docker compose down", "output": ["[+] Running 3/3", " ✔ Container compose-lab-web-1    Removed   0.3s",
     " ✔ Container compose-lab-redis-1  Removed   0.2s", " ✔ Network compose-lab_default    Removed   0.1s"]}
   ]
  }
 ]
}
